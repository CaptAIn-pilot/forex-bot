# Environment configuration template

# Database settings
DATABASE_URL=sqlite:///./ai_prompts.db

# GitHub settings (optional, for private repositories)
GITHUB_TOKEN=

# API settings
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=False

# Analysis settings
MIN_QUALITY_SCORE=5.0
MAX_PROCESSING_BATCH_SIZE=100

# Model settings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CLASSIFICATION_MODEL=microsoft/DialoGPT-medium

# Vector database settings
VECTOR_DB_PATH=./chromadb
VECTOR_DB_COLLECTION=ai_prompts

# Processing settings
MAX_FILE_SIZE_MB=10

# Logging settings
LOG_LEVEL=INFO
LOG_FILE=